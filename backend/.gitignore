# ============================================================
# 智慧课堂后端 .gitignore
# ============================================================

# ⚠️ 敏感配置文件 —— 永不提交
.env
*.env.local

# Python 编译缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# 虚拟环境
venv/
env/
.venv/
.env/

# 用户上传的文件（数据不应进代码仓库）
uploads/

# IDE 配置
.vscode/
.idea/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db

# 日志文件
*.log
logs/
