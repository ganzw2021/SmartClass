# ============================================================
# 智慧课堂系统 - 环境配置模板
# 复制此文件为 .env 并填入真实值，.env 不提交 Git
# ============================================================

# Flask 运行环境（development / production）
FLASK_ENV=development

# JWT 签名密钥 —— 使用以下命令生成随机密钥：
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=替换为随机生成的长字符串

# 数据库连接配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=替换为数据库密码
DB_NAME=smartclass
